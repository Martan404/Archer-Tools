#!/usr/bin/env bash
# Set swedish audio as the default in movie files

set -euo pipefail
INPUT="$1"
DIR=$(dirname -- "$INPUT")
FILE=$(basename -- "$INPUT")

EXT="${FILE##*.}"
NAME="${FILE%.*}"

case "$EXT" in
  mp4|mkv|avi)
    ;;
  *)
    echo "Unsupported file type: .$EXT"
    echo "Supported types: mp4, mkv, avi"
    exit 0
    ;;
esac
mkdir -p "${DIR}/swe-default"
OUTPUT="${DIR}/swe-default/${NAME}.${EXT}"

if [[ -z "${INPUT:-}" ]]; then
  echo "Usage: $0 <input_file> [output_file]"
  exit 1
fi

mapfile -t AUDIO_STREAMS < <(
  ffprobe -v error \
    -select_streams a \
    -show_entries stream=index:stream_tags=language \
    -of csv=p=0 "$INPUT"
)

SWE_STREAM=""
OTHER_STREAMS=()

for line in "${AUDIO_STREAMS[@]}"; do
  INDEX="${line%%,*}"
  LANG="${line#*,}"

  if [[ "$LANG" == "swe" ]]; then
    SWE_STREAM="$INDEX"
  else
    OTHER_STREAMS+=("$INDEX")
  fi
done

if [[ -z "$SWE_STREAM" ]]; then
  echo "No Swedish (swe) audio track found."
  exit 1
fi

echo "Swedish audio stream index: $SWE_STREAM"

MAP_ARGS=()
MAP_ARGS+=("-map" "0:v")
MAP_ARGS+=("-map" "0:$SWE_STREAM")

for idx in "${OTHER_STREAMS[@]}"; do
  MAP_ARGS+=("-map" "0:$idx")
done

MAP_ARGS+=("-map" "0:s?")
MAP_ARGS+=("-map" "0:d?")

ffmpeg -i "$INPUT" \
  "${MAP_ARGS[@]}" \
  -c copy \
  -disposition:a 0 \
  -disposition:a:0 default \
  "$OUTPUT"

echo "Done. Swedish audio is now first and default."
